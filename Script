local activeWeapons = {}
local assetFolder = game:GetService("Players").LocalPlayer.PlayerScripts.Assets.ViewModels

local function swapWeaponSkins(normalWeaponName, skinName, State)
    if not normalWeaponName then return end
    local normalWeapon = assetFolder:FindFirstChild(normalWeaponName)
    if not normalWeapon then return end

    if State then
        if skinName then
            local skin = assetFolder:FindFirstChild(skinName)
            if not skin then return end
            if not activeWeapons[normalWeaponName] then
                local backup = normalWeapon:Clone()
                backup.Name = normalWeaponName .. "_Backup"
                backup.Parent = assetFolder
            end
            normalWeapon:ClearAllChildren()
            for _, child in pairs(skin:GetChildren()) do
                child:Clone().Parent = normalWeapon
            end
            activeWeapons[normalWeaponName] = true
        end
    else
        local backup = assetFolder:FindFirstChild(normalWeaponName .. "_Backup")
        if backup then
            normalWeapon:ClearAllChildren()
            for _, child in pairs(backup:GetChildren()) do
                child:Clone().Parent = normalWeapon
            end
            backup:Destroy()
        end
        activeWeapons[normalWeaponName] = nil
    end
end

local function resetAll()
    for _, backup in pairs(assetFolder:GetChildren()) do
        if backup.Name:find("_Backup") then
            local baseName = backup.Name:gsub("_Backup", "")
            local weapon = assetFolder:FindFirstChild(baseName)
            if weapon then
                weapon:ClearAllChildren()
                for _, child in pairs(backup:GetChildren()) do
                    child:Clone().Parent = weapon
                end
            end
            backup:Destroy()
        end
    end
    activeWeapons = {}
end

-- ==========================================
-- 4. GUI OBSIDIAN
-- ==========================================
local selectedWeapon = nil
local selectedSkin = nil

LeftGroupbox:AddDropdown("WeaponSelect", {
    Values = (function()
        local list = {}
        for weapon, _ in pairs(weaponSkins) do
            table.insert(list, weapon)
        end
        table.sort(list)
        return list
    end)(),
    Default = 1,
    Multi = false,
    Text = "Choisir une arme",
    Callback = function(Value)
        selectedWeapon = Value
    end
})

LeftGroupbox:AddDropdown("SkinSelect", {
    Values = (function()
        local allSkins = {"Aucune"}
        for _, skins in pairs(weaponSkins) do
            for _, skin in ipairs(skins) do
                table.insert(allSkins, skin)
            end
        end
        table.sort(allSkins)
        return allSkins
    end)(),
    Default = 1,
    Multi = false,
    Text = "Choisir une skin",
    Callback = function(Value)
        if Value == "Aucune" then
            selectedSkin = nil
        else
            selectedSkin = Value
        end
    end
})

RightGroupbox:AddButton({
    Text = "Appliquer la skin",
    Tooltip = "Applique la skin sélectionnée à l'arme choisie",
    Func = function()
        if not selectedWeapon then
            Library:Notify({Title = "Erreur", Content = "Aucune arme sélectionnée", Duration = 3})
            return
        end
        if not selectedSkin then
            Library:Notify({Title = "Erreur", Content = "Aucune skin sélectionnée", Duration = 3})
            return
        end
        local success, err = pcall(function()
            swapWeaponSkins(selectedWeapon, selectedSkin, true)
        end)
        if success then
            Library:Notify({Title = "Succès", Content = "Skin appliquée: " .. selectedSkin, Duration = 3})
        else
            Library:Notify({Title = "Erreur", Content = tostring(err), Duration = 3})
        end
    end
})

RightGroupbox:AddButton({
    Text = "Reset l'arme",
    Tooltip = "Remet l'arme sélectionnée à son apparence d'origine",
    Func = function()
        if not selectedWeapon then
            Library:Notify({Title = "Erreur", Content = "Aucune arme sélectionnée", Duration = 3})
            return
        end
        local success, err = pcall(function()
            swapWeaponSkins(selectedWeapon, nil, false)
        end)
        if success then
            Library:Notify({Title = "Succès", Content = "Arme reset: " .. selectedWeapon, Duration = 3})
        else
            Library:Notify({Title = "Erreur", Content = tostring(err), Duration = 3})
        end
    end
})

RightGroupbox:AddButton({
    Text = "Reset TOUT",
    Tooltip = "Remet toutes les armes modifiées à leur apparence d'origine",
    Func = function()
        local success, err = pcall(resetAll)
        if success then
            Library:Notify({Title = "Succès", Content = "Toutes les armes ont été reset", Duration = 3})
        else
            Library:Notify({Title = "Erreur", Content = tostring(err), Duration = 3})
        end
    end
})

